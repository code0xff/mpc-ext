{
  "openapi": "3.1.0",
  "info": {
    "title": "mpc-ext server",
    "description": "Holds one share of a 2-of-3 MPC key, joins signing, and verifies server-origin WebAuthn passkey ceremonies.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/v1/device-key": {
      "post": {
        "tags": [],
        "summary": "Registers a wallet's first device key. Signing endpoints verify requests with this key.",
        "description": "A wallet that already has one is refused: replacing a key needs a recovery.",
        "operationId": "register_device_key",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDeviceKey"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "device key registered"
          },
          "400": {
            "description": "malformed request"
          }
        }
      }
    },
    "/v1/dkg/round": {
      "post": {
        "tags": [],
        "summary": "Advances to the next round using the envelopes supplied.",
        "operationId": "advance_dkg",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceDkg"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "round advanced, or DKG complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvancedDkg"
                }
              }
            }
          },
          "404": {
            "description": "unknown or expired session"
          }
        }
      }
    },
    "/v1/dkg/session": {
      "post": {
        "tags": [],
        "summary": "Opens a DKG session and returns the server's round 1 envelopes.",
        "operationId": "start_dkg",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartDkg"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "session opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedDkg"
                }
              }
            }
          },
          "400": {
            "description": "malformed request"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "tags": [],
        "summary": "Returns the server's status.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "the server is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/passkeys/assert/finish": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Verifies one passkey assertion and consumes its operation binding.",
        "operationId": "assert_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertFinishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "assertion verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssertFinishResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/passkeys/assert/options": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Starts a passkey assertion bound to one exact operation.",
        "operationId": "assert_options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertOptionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "assertion options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssertOptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/passkeys/ceremony/status": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Returns browser ceremony progress to the extension without exposing credential state.",
        "operationId": "ceremony_status",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CeremonyStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "browser ceremony status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/passkeys/handoff": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Creates the one-use browser handoff after verifying device possession.",
        "operationId": "handoff",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HandoffRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "browser ceremony handoff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HandoffResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/passkeys/register/finish": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Verifies and stores a new passkey credential.",
        "operationId": "register_finish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterFinishRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "passkey registered"
          }
        }
      }
    },
    "/v1/passkeys/register/options": {
      "post": {
        "tags": [
          "passkey"
        ],
        "summary": "Starts a passkey registration ceremony.",
        "operationId": "register_options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterOptionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "registration options",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterOptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recovery/cancel": {
      "post": {
        "tags": [
          "crate::recovery"
        ],
        "summary": "Cancels a recovery. Either the wallet's current device key or the request's own key may sign,\nso the existing install can object, and the requester can withdraw.",
        "operationId": "cancel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "cancelled"
          },
          "404": {
            "description": "nothing to cancel"
          }
        }
      }
    },
    "/v1/recovery/complete": {
      "post": {
        "tags": [
          "crate::recovery"
        ],
        "summary": "Replaces the wallet's device key with this request's, once the cooling-off period is over.\nSigned with the new device key.",
        "operationId": "complete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "the device key was replaced"
          },
          "400": {
            "description": "the cooling-off period has not ended"
          },
          "404": {
            "description": "unknown, cancelled or lapsed request"
          }
        }
      }
    },
    "/v1/recovery/pending": {
      "post": {
        "tags": [
          "crate::recovery"
        ],
        "summary": "Lists the recoveries waiting on a wallet. Signed with the wallet's current device key, so it\nis how an existing install learns that someone asked to replace it.",
        "operationId": "pending",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListRecoveries"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "recoveries waiting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingRecoveries"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recovery/request": {
      "post": {
        "tags": [
          "crate::recovery"
        ],
        "summary": "Starts a recovery and opens the passkey ceremony that has to approve it.",
        "description": "Nothing changes yet. The request only asks for an assertion bound to the new device key.",
        "operationId": "request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestRecovery"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "request recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryRequested"
                }
              }
            }
          },
          "404": {
            "description": "no such wallet, or it has no passkey"
          },
          "429": {
            "description": "too many requests for this wallet"
          }
        }
      }
    },
    "/v1/recovery/status": {
      "post": {
        "tags": [
          "crate::recovery"
        ],
        "summary": "Reports where a request stands, and starts its cooling-off period once the passkey assertion\nfor it has been verified. Signed with the new device key.",
        "operationId": "status",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecoveryCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "the request's state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoveryState"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid device proof"
          }
        }
      }
    },
    "/v1/reshare/abort": {
      "post": {
        "tags": [
          "crate::reshare"
        ],
        "summary": "Abandons a reshare. The previous share stays live.",
        "operationId": "abort",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishReshare"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "the reshare was dropped"
          }
        }
      }
    },
    "/v1/reshare/commit": {
      "post": {
        "tags": [
          "crate::reshare"
        ],
        "summary": "Makes the staged share the live one and deletes the old share.",
        "description": "Call it only after the user has saved the new recovery file. Until then an abort, or a\ntimeout, leaves the previous share in place.",
        "operationId": "commit",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishReshare"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "the new share is live"
          },
          "404": {
            "description": "nothing staged, or it expired"
          }
        }
      }
    },
    "/v1/reshare/round": {
      "post": {
        "tags": [
          "crate::reshare"
        ],
        "summary": "Advances the reshare by one round. The last round stages the new share.",
        "operationId": "advance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceReshare"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "round advanced, or new share staged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvancedReshare"
                }
              }
            }
          },
          "404": {
            "description": "unknown or expired session"
          }
        }
      }
    },
    "/v1/reshare/session": {
      "post": {
        "tags": [
          "crate::reshare"
        ],
        "summary": "Opens a reshare session and returns the server's round 1 envelopes.",
        "operationId": "start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartReshare"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "session opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedReshare"
                }
              }
            }
          },
          "401": {
            "description": "missing device proof or passkey grant"
          },
          "404": {
            "description": "no key for this wallet"
          }
        }
      }
    },
    "/v1/sign/round": {
      "post": {
        "tags": [],
        "summary": "Advances the signing protocol by one round.",
        "operationId": "advance_sign",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceSign"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "round advanced, or signing complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdvancedSign"
                }
              }
            }
          },
          "404": {
            "description": "unknown or expired session"
          }
        }
      }
    },
    "/v1/sign/session": {
      "post": {
        "tags": [],
        "summary": "Opens a signing session and returns the server's round 1 envelopes.",
        "description": "The server is a second factor, so this is where policy belongs: rate limits, anomaly\nblocking and user confirmation all hang off this endpoint once authentication exists\n(`docs/server.md`).",
        "operationId": "start_sign",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSign"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "session opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedSign"
                }
              }
            }
          },
          "404": {
            "description": "no key for this wallet"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdvanceDkg": {
        "type": "object",
        "description": "A request to advance a DKG round.",
        "required": [
          "session_id",
          "wallet_id",
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The envelopes being delivered to the server."
          },
          "session_id": {
            "type": "string",
            "description": "The session id, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "AdvanceReshare": {
        "type": "object",
        "description": "A request to advance a reshare round.",
        "required": [
          "wallet_id",
          "reshare_id",
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The envelopes being delivered to the server."
          },
          "reshare_id": {
            "type": "string",
            "description": "The reshare id, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "AdvanceSign": {
        "type": "object",
        "description": "A request to advance a signing round.",
        "required": [
          "wallet_id",
          "sign_id",
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The envelopes being delivered to the server."
          },
          "sign_id": {
            "type": "string",
            "description": "The signature id, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "AdvancedDkg": {
        "oneOf": [
          {
            "type": "object",
            "description": "Still running. Deliver the envelopes and call again.",
            "required": [
              "envelopes",
              "state"
            ],
            "properties": {
              "envelopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WireEnvelope"
                },
                "description": "The envelopes the server sends."
              },
              "state": {
                "type": "string",
                "enum": [
                  "inProgress"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The DKG finished and the server stored share C.",
            "required": [
              "public_key",
              "state"
            ],
            "properties": {
              "public_key": {
                "type": "string",
                "description": "The SEC1 compressed public key, hex-encoded."
              },
              "state": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              }
            }
          }
        ],
        "description": "The response to advancing a DKG round."
      },
      "AdvancedReshare": {
        "oneOf": [
          {
            "type": "object",
            "description": "Still running. Deliver the envelopes and call again.",
            "required": [
              "envelopes",
              "state"
            ],
            "properties": {
              "envelopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WireEnvelope"
                },
                "description": "The envelopes the server sends."
              },
              "state": {
                "type": "string",
                "enum": [
                  "inProgress"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The reshare finished and the new share is staged. It takes effect on commit.",
            "required": [
              "public_key",
              "state"
            ],
            "properties": {
              "public_key": {
                "type": "string",
                "description": "The SEC1 compressed public key, hex-encoded. It equals the wallet's existing key."
              },
              "state": {
                "type": "string",
                "enum": [
                  "staged"
                ]
              }
            }
          }
        ],
        "description": "The response to advancing a reshare round."
      },
      "AdvancedSign": {
        "oneOf": [
          {
            "type": "object",
            "description": "Still running. Deliver the envelopes and call again.",
            "required": [
              "envelopes",
              "state"
            ],
            "properties": {
              "envelopes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WireEnvelope"
                },
                "description": "The envelopes the server sends."
              },
              "state": {
                "type": "string",
                "enum": [
                  "inProgress"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Signing finished. The signature is returned as 65 hex-encoded bytes (r || s || v).",
            "required": [
              "signature",
              "state"
            ],
            "properties": {
              "signature": {
                "type": "string",
                "description": "The signature, hex-encoded."
              },
              "state": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              }
            }
          }
        ],
        "description": "The response to advancing a signing round."
      },
      "AssertFinishRequest": {
        "type": "object",
        "description": "Completes an assertion ceremony.",
        "required": [
          "wallet_id",
          "challenge_id",
          "purpose",
          "operation_id",
          "digest",
          "credential"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "The opaque challenge identifier returned by the options endpoint."
          },
          "credential": {
            "type": "object",
            "description": "The browser's `PublicKeyCredential` JSON object."
          },
          "digest": {
            "type": "string",
            "description": "Must exactly match the values bound when options were requested."
          },
          "operation_id": {
            "type": "string",
            "description": "Must exactly match the values bound when options were requested."
          },
          "purpose": {
            "type": "string",
            "description": "Must exactly match the values bound when options were requested."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "AssertFinishResponse": {
        "type": "object",
        "description": "The result of a verified assertion.",
        "required": [
          "verified",
          "purpose",
          "operation_id"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "Echoes the already validated operation identifier."
          },
          "purpose": {
            "type": "string",
            "description": "Echoes the already validated policy purpose."
          },
          "verified": {
            "type": "boolean",
            "description": "Always true on a successful response."
          }
        }
      },
      "AssertOptionsRequest": {
        "type": "object",
        "description": "Starts an assertion ceremony bound to one exact operation.",
        "required": [
          "wallet_id",
          "purpose",
          "operation_id",
          "digest"
        ],
        "properties": {
          "digest": {
            "type": "string",
            "description": "The exact 32-byte operation digest, encoded as lowercase or uppercase hex."
          },
          "operation_id": {
            "type": "string",
            "description": "Application-generated operation identifier."
          },
          "purpose": {
            "type": "string",
            "description": "The policy operation, currently `sign` or `recovery`."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "AssertOptionsResponse": {
        "type": "object",
        "description": "A browser assertion ceremony's public options.",
        "required": [
          "challenge_id",
          "options"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "Opaque server-side ceremony identifier. It is submitted in the next request body."
          },
          "options": {
            "type": "object",
            "description": "The options passed to `navigator.credentials.get`."
          }
        }
      },
      "CeremonyStatusRequest": {
        "type": "object",
        "required": [
          "wallet_id",
          "ceremony_id"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string"
          },
          "wallet_id": {
            "type": "string"
          }
        }
      },
      "CeremonyStatusResponse": {
        "type": "object",
        "description": "A device-authenticated, non-secret view of a browser ceremony.",
        "required": [
          "ceremony_id",
          "status"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "FinishReshare": {
        "type": "object",
        "description": "A request to commit or abort a reshare.",
        "required": [
          "wallet_id",
          "reshare_id"
        ],
        "properties": {
          "reshare_id": {
            "type": "string",
            "description": "The reshare id, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "HandoffRequest": {
        "type": "object",
        "description": "Starts a server-origin browser ceremony after device-key authentication.",
        "required": [
          "wallet_id",
          "purpose"
        ],
        "properties": {
          "digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string",
            "description": "`register`, `sign`, or `recovery`."
          },
          "wallet_id": {
            "type": "string"
          }
        }
      },
      "HandoffResponse": {
        "type": "object",
        "description": "A one-use token delivered to the extension and then submitted in an HTML form body.",
        "required": [
          "ceremony_id",
          "handoff_token"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string"
          },
          "handoff_token": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "The health-check response.",
        "required": [
          "status",
          "threshold"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `\"ok\"`."
          },
          "threshold": {
            "type": "string",
            "description": "This build's threshold configuration, for example `\"2-of-3\"`."
          }
        }
      },
      "ListRecoveries": {
        "type": "object",
        "description": "A request to list what is waiting on a wallet.",
        "required": [
          "wallet_id"
        ],
        "properties": {
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "PendingRecoveries": {
        "type": "object",
        "description": "The recoveries waiting on a wallet.",
        "required": [
          "pending"
        ],
        "properties": {
          "pending": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PendingRecovery"
            },
            "description": "Recoveries past their passkey assertion and not yet completed or cancelled."
          }
        }
      },
      "PendingRecovery": {
        "type": "object",
        "description": "One recovery waiting on a wallet.",
        "required": [
          "request_id",
          "requested_at",
          "ready_at",
          "key_fingerprint"
        ],
        "properties": {
          "key_fingerprint": {
            "type": "string",
            "description": "A short fingerprint of the key that would take over, to compare with the requester's."
          },
          "ready_at": {
            "type": "integer",
            "format": "int64",
            "description": "When the cooling-off period ends, in unix seconds."
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "requested_at": {
            "type": "integer",
            "format": "int64",
            "description": "When it was made, in unix seconds."
          }
        }
      },
      "RecoveryCall": {
        "type": "object",
        "description": "A call about one request, signed with the new device key.",
        "required": [
          "wallet_id",
          "request_id"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "description": "The request, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "RecoveryRequested": {
        "type": "object",
        "description": "The response to a recovery request.",
        "required": [
          "request_id",
          "ceremony_id",
          "handoff_token"
        ],
        "properties": {
          "ceremony_id": {
            "type": "string",
            "description": "The browser ceremony for the passkey assertion."
          },
          "handoff_token": {
            "type": "string",
            "description": "The one-use token that starts that ceremony. Submit it in a form body, never in a URL."
          },
          "request_id": {
            "type": "string",
            "description": "Identifies this request in every later call, 64 hex characters."
          }
        }
      },
      "RecoveryState": {
        "oneOf": [
          {
            "type": "object",
            "description": "Waiting for the passkey assertion.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "awaitingAssertion"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The assertion was verified. It can be completed once `ready_at` (unix seconds) has passed.",
            "required": [
              "ready_at",
              "state"
            ],
            "properties": {
              "ready_at": {
                "type": "integer",
                "format": "int64",
                "description": "When the cooling-off period ends, in unix seconds."
              },
              "state": {
                "type": "string",
                "enum": [
                  "cooling"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The cooling-off period is over: call `complete`.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "ready"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The device key was replaced.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "completed"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Cancelled before it finished.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "cancelled"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Lapsed before it finished.",
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "expired"
                ]
              }
            }
          }
        ],
        "description": "Where a recovery request stands."
      },
      "RegisterDeviceKey": {
        "type": "object",
        "description": "A device public-key registration request.",
        "required": [
          "wallet_id",
          "public_key"
        ],
        "properties": {
          "public_key": {
            "type": "string",
            "description": "The raw SEC1 public key, encoded as lowercase hex."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "RegisterFinishRequest": {
        "type": "object",
        "description": "Completes a registration ceremony.",
        "required": [
          "wallet_id",
          "challenge_id",
          "credential"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "The opaque challenge identifier returned by the options endpoint."
          },
          "credential": {
            "type": "object",
            "description": "The browser's `PublicKeyCredential` JSON object."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "RegisterOptionsRequest": {
        "type": "object",
        "description": "Starts a registration ceremony for a wallet identified by its device key.",
        "required": [
          "wallet_id"
        ],
        "properties": {
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "RegisterOptionsResponse": {
        "type": "object",
        "description": "A browser registration ceremony's public options.",
        "required": [
          "challenge_id",
          "options"
        ],
        "properties": {
          "challenge_id": {
            "type": "string",
            "description": "Opaque server-side ceremony identifier. It is submitted in the next request body."
          },
          "options": {
            "type": "object",
            "description": "The options passed to `navigator.credentials.create`."
          }
        }
      },
      "RequestRecovery": {
        "type": "object",
        "description": "A request to start a recovery. It carries no device proof: the install asking has none yet.",
        "required": [
          "wallet_id",
          "device_public_key"
        ],
        "properties": {
          "device_public_key": {
            "type": "string",
            "description": "The new install's public device key: 65 bytes, uncompressed SEC1, as lowercase hex."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "StartDkg": {
        "type": "object",
        "description": "A request to open a DKG session.",
        "required": [
          "wallet_id",
          "session_id"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "description": "The session id shared by every party, 64 hex characters."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier, generated by the client."
          }
        }
      },
      "StartReshare": {
        "type": "object",
        "description": "A request to open a reshare session.",
        "required": [
          "wallet_id",
          "reshare_id"
        ],
        "properties": {
          "reshare_id": {
            "type": "string",
            "description": "A unique id for this reshare, 64 hex characters. Never reuse one."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "StartSign": {
        "type": "object",
        "description": "A request to open a signing session.",
        "required": [
          "wallet_id",
          "sign_id",
          "digest",
          "counterparty"
        ],
        "properties": {
          "counterparty": {
            "type": "integer",
            "format": "int32",
            "description": "Which party the client is driving (0 for the extension share, 1 for the recovery file).",
            "minimum": 0
          },
          "digest": {
            "type": "string",
            "description": "The 32-byte digest being signed, hex-encoded."
          },
          "sign_id": {
            "type": "string",
            "description": "A unique id for this signature, 64 hex characters. Never reuse one."
          },
          "wallet_id": {
            "type": "string",
            "description": "The wallet identifier."
          }
        }
      },
      "StartedDkg": {
        "type": "object",
        "description": "The response to opening a DKG session.",
        "required": [
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The round 1 envelopes the server sends."
          }
        }
      },
      "StartedReshare": {
        "type": "object",
        "description": "The response to opening a reshare session.",
        "required": [
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The round 1 envelopes the server sends."
          }
        }
      },
      "StartedSign": {
        "type": "object",
        "description": "The response to opening a signing session.",
        "required": [
          "envelopes"
        ],
        "properties": {
          "envelopes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireEnvelope"
            },
            "description": "The round 1 envelopes the server sends."
          }
        }
      },
      "WireEnvelope": {
        "type": "object",
        "description": "A single envelope. The body travels base64-encoded.",
        "required": [
          "round",
          "from",
          "payload"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int32",
            "description": "The sending party, 0-based.",
            "minimum": 0
          },
          "payload": {
            "type": "string",
            "description": "The base64-encoded body."
          },
          "round": {
            "type": "integer",
            "format": "int32",
            "description": "The protocol round number.",
            "minimum": 0
          },
          "to": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The recipient. Omitted means broadcast.",
            "minimum": 0
          }
        }
      }
    }
  }
}
